PORT=8787
DATA_DIR=./data
# Comma-separated exact origins. Use * only inside a trusted network.
EMBED_ORIGINS=https://example.com,https://grafana.example.com
# Prometheus datasource. Panels query through the server, so the browser never talks to Prometheus directly.
PROMETHEUS_URL=http://prometheus.example.com:9090
# Optional bearer token sent as Authorization to Prometheus. Never exposed to the client.
# PROMETHEUS_TOKEN=
# Deduplicates identical panel queries across concurrent requests.
PROMETHEUS_CACHE_TTL_MS=10000
